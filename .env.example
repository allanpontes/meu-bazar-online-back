# Copie para .env e preencha. O .env nunca vai para o git.
# Use valores diferentes em develop e produção (nunca reaproveite segredos entre ambientes).

# Postgres (Neon). No develop, use a credencial da branch develop do Neon, com role própria.
# Use o prefixo postgresql+psycopg2:// (o driver do projeto é o psycopg2). Com postgresql:// puro, o SQLAlchemy 2.1+
# tenta usar o psycopg v3 e dá ModuleNotFoundError. Para o Alembic use a conexão direta (host sem -pooler).
DATABASE_URL=postgresql+psycopg2://usuario:senha@host/banco?sslmode=require

# Opcional, só para o Alembic: conexão direta do Neon (host sem -pooler, prefixo postgresql+psycopg2://).
# Obrigatória no Render se o DATABASE_URL de lá usar o pooler. Vazia = o Alembic usa o DATABASE_URL.
# DATABASE_URL_MIGRACAO=postgresql+psycopg2://usuario:senha@host-direto/banco?sslmode=require

# Segredo que assina os JWT. Mínimo 32 caracteres aleatórios, único por ambiente.
# Para gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRA_MINUTOS=480

# Origens do front, separadas por vírgula. Sem '*' e sem barra no final.
# Publicado: só o domínio do front (sem localhost). Local: http://localhost:4200
FRONTEND_ORIGINS=http://localhost:4200

# Local (http): COOKIE_SECURE=false e COOKIE_SAMESITE=lax.
# Publicado (https): COOKIE_SECURE=true; se front e API estiverem em domínios diferentes, COOKIE_SAMESITE=none.
# COOKIE_SAMESITE=none exige COOKIE_SECURE=true (o app não sobe sem isso).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Documentação interativa (/docs, /redoc, /openapi.json). Padrão: desligada.
# Local e develop: true. Produção: false (ou deixe sem definir).
DOCS_ATIVOS=true

# Limite de requisições por IP (login, reservar na sacola, criar pedido), formato "N/minute;N/hour".
# Operadoras móveis compartilham IP entre clientes: se clientes reais forem barrados (429), aumente os valores.
LIMITES_ATIVOS=true
LIMITE_LOGIN=5/minute;20/hour
LIMITE_SACOLA=10/minute;30/hour
LIMITE_PEDIDOS=3/minute;10/hour
# Proxies confiáveis na frente da API. O IP do visitante é a N-ésima entrada de trás para frente em X-Forwarded-For.
# Render: 3 (visitante, borda da Cloudflare, proxy interno do Render). Local, sem proxy: o cabeçalho não existe e vale o IP da conexão.
# Se o log do Render mostrar "PROXY_SALTOS=... provavelmente errado", a infraestrutura mudou: confira o número.
PROXY_SALTOS=3

# Sacola: tempo de reserva em minutos e máximo de itens por sessão.
SACOLA_MINUTOS=15
SACOLA_MAX_ITENS=10

# Pedido: horas para combinar o pagamento. Vencido o prazo, o pedido vira Expirado e as peças voltam à vitrine.
PEDIDO_HORAS_PAGAMENTO=12
