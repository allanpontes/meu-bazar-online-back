# Copie para .env e preencha. O .env nunca vai para o git.
# Use valores diferentes em develop e produção (nunca reaproveite segredos entre ambientes).

# Postgres (Neon). No develop, use a credencial da branch develop do Neon, com role própria.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo que assina os JWT. Mínimo 32 caracteres aleatórios, único por ambiente.
# Para gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRA_MINUTOS=480

# Origens do front, separadas por vírgula. Sem '*' e sem barra no final.
# Publicado: só o domínio do front (sem localhost). Local: http://localhost:4200
FRONTEND_ORIGINS=http://localhost:4200

# Local (http): COOKIE_SECURE=false e COOKIE_SAMESITE=lax.
# Publicado (https): COOKIE_SECURE=true; se front e API estiverem em domínios diferentes, COOKIE_SAMESITE=none.
# COOKIE_SAMESITE=none exige COOKIE_SECURE=true (o app não sobe sem isso).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Documentação interativa (/docs, /redoc, /openapi.json). Padrão: desligada.
# Local e develop: true. Produção: false (ou deixe sem definir).
DOCS_ATIVOS=true

# Sacola: tempo de reserva em minutos e máximo de itens por sessão.
SACOLA_MINUTOS=15
SACOLA_MAX_ITENS=10
